# Email Configuration Template
# Copy this content to a .env file in your project root

# SendGrid Configuration
SENDGRID_API_KEY=your_sendgrid_api_key_here
TO_EMAIL_ADDRESS=To_email_here
FROM_EMAIL_ADDRESS=from_email_here

# Optional: Email subject customization
EMAIL_SUBJECT=Test Execution Report - go4WB Automated Testing

# Valid User Credentials Prod
TEST_VALID_USER_EMAIL=JUNIOR_USER
TEST_VALID_USER_PASSWORD=JUNIOR_PASSWORD

# Valid User Credentials Prod For Decline Inquiry
TEST_DECLINE_INQUIRY_USER_EMAIL=DECLINE_USER_FOR_INQUIRY
TEST_DECLINE_INQUIRY_USER_PASSWORD=DECLINE_USER_PASSWORD

# Valid Gold User Credentials Prod 
TEST_GOLD_USER_EMAIL = GOLD_USER
TEST_GOLD_USER_PASSWORD = GOLD_USER_PASSWORD

# Valid Gold User Credentials Prod For Decline Buylead Inquiry
TEST_DECLINE_BUYLEAD_INQUIRY_USER_EMAIL=DECLINE_USER_FOR_INQUIRY_BUYLEAD
TEST_DECLINE_BUYLEAD_INQUIRY_USER_PASSWORD=DECLINE_PASSWORD_FOR_INQUIRY_BUYLEAD

# Auth Code For Gold Users
AUTH_CODE = AUTHCODE_HERE
# For UAT
# AUTH_CODE = UAT_AUTHCODE_HERE

# Valid Coupons
VALID_COUPON=VALID_COUPON
VALID_COUPON_FOR_GP=VALID_COUPON_GP
VALID_COUPON_FOR_GL=VALID_COUPON_GL
VALID_COUPON_FOR_SL=VALID_COUPON_SL
VALID_COUPON_FOR_WB=VALID_COUPON_WB


# Instructions:
# 1. Replace 'your_sendgrid_api_key_here' with your actual SendGrid API key
# 2. Replace 'recipient@example.com' with the email address where you want to receive reports
# 3. Replace 'your_verified_sender@example.com' with your verified SendGrid sender email
# 4. Replace 'your_valid_user_email@example.com' with your valid test user email
# 5. Replace 'your_valid_user_password' with your valid test user password
# 6. Optionally customize the email subject
# 7. Save this as .env file in your project root
# 8. Make sure .env is in your .gitignore to keep your credentials secure 